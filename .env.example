# ==============================================================================
# ROUTEMIND AI - ENVIRONMENT CONFIGURATION
# "Predict. Optimize. Move Smarter."
# ==============================================================================

# Server Network Port
PORT=5000

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key (Optional: App falls back to built-in grounded reasoning engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Supabase PostgreSQL (Optional: App runs with zero-config local persistent store out-of-the-box)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n Automation Webhook Integration
N8N_WEBHOOK_URL=
